<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 colour roles, Google's dark scheme — the same values as CastColor.dark(),
  exposed as resources so XML can use them. Components ask for a role, never for a raw
  colour: that is what makes re-theming a one-line change.

  Sampled pixel by pixel from Google's own dark apps (Play Store, Translate, Maps, Earth,
  Gboard). Note this is NOT the M3 baseline palette: the spec's reference theme is
  purple-tinted (#D0BCFF on #141218) and no Google app actually ships it. Google's apps
  agree on a neutral #131313 surface and a light periwinkle #B2C5FF primary.
-->
<resources>
    <!-- primary -->
    <color name="m3_primary">#FFB2C5FF</color>
    <color name="m3_on_primary">#FF002E69</color>
    <color name="m3_primary_container">#FF004A77</color>
    <color name="m3_on_primary_container">#FFC2E7FF</color>

    <!-- secondary -->
    <color name="m3_secondary">#FFC2E7FF</color>
    <color name="m3_on_secondary">#FF003355</color>
    <color name="m3_secondary_container">#FF004A77</color>
    <color name="m3_on_secondary_container">#FFC2E7FF</color>

    <!-- tertiary -->
    <color name="m3_tertiary">#FFD3E3FD</color>
    <color name="m3_tertiary_container">#FF1A4C78</color>
    <color name="m3_on_tertiary_container">#FFD3E3FD</color>

    <!-- error -->
    <color name="m3_error">#FFF2B8B5</color>
    <color name="m3_on_error">#FF601410</color>
    <color name="m3_error_container">#FF8C1D18</color>
    <color name="m3_on_error_container">#FFF9DEDC</color>

    <!-- surfaces -->
    <color name="m3_surface">#FF131313</color>
    <color name="m3_on_surface">#FFE3E3E3</color>
    <color name="m3_surface_variant">#FF444746</color>
    <color name="m3_on_surface_variant">#FFC4C7C5</color>
    <color name="m3_surface_container_lowest">#FF0E0E0E</color>
    <color name="m3_surface_container_low">#FF1B1B1B</color>
    <color name="m3_surface_container">#FF1F1F1F</color>
    <color name="m3_surface_container_high">#FF2A2A2A</color>
    <color name="m3_surface_container_highest">#FF363636</color>

    <!-- lines -->
    <color name="m3_outline">#FF8E918F</color>
    <color name="m3_outline_variant">#FF444746</color>
    <color name="m3_scrim">#99000000</color>
    <!-- 10% primary: what M3 paints on press, instead of changing the fill. -->
    <color name="m3_state_layer">#1AB2C5FF</color>
</resources>
