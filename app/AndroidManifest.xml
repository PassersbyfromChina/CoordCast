<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.coordcast">

    <!--
      minSdk / targetSdk / versionCode / versionName are injected by tools/build.ps1
      through aapt2 link, so they have exactly one source of truth.
    -->

    <!--
      Android 11+ (API 30) package visibility.
      Launching an activity never needs this, but the resolve/query calls this app
      makes do: it checks which map apps are installed, whether each map scheme
      resolves, and whether a browser or app store can handle the fallbacks.
    -->
    <queries>
        <!-- Map apps with a dedicated deep link. -->
        <package android:name="com.autonavi.minimap" />
        <package android:name="com.autonavi.amapauto" />
        <package android:name="com.baidu.BaiduMap" />
        <package android:name="com.baidu.BaiduMapCar" />
        <package android:name="com.tencent.map" />
        <package android:name="com.google.android.apps.maps" />

        <!-- Every map scheme this app can emit. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="androidamap" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="amapuri" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="baidumap" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="qqmap" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <!-- The standard one, which is how "any other map app" is discovered. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.coordcast.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Accept coordinates shared from other apps (e.g. a note, chat, or map app). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
